{
  "manifest_version": 3,
  "name": "Sender View",
  "description": "Chat-style, person-centric view of your Inbox and Sent mail across all accounts.",
  "version": "0.6.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "{79c9baab-f570-4e8a-9721-82d2d2fab86c}",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["messagesRead", "messagesUpdate", "messagesMove", "messagesDelete", "accountsRead", "storage", "compose", "compose.send"],
  "icons": {
    "16": "icons/senderview.svg",
    "32": "icons/senderview.svg",
    "64": "icons/senderview.svg"
  }
}
